{
  "name": "deepseek-agent",
  "version": "0.8.0",
  "description": "DeepSeek Agent：能调用工具、连接本机与 MCP、预览工作区 diff 的静态 Agent。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "build:harmony": "node scripts/build.mjs && node scripts/sync-harmony-assets.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "backup:signing": "node scripts/backup-signing.mjs",
    "push": "node scripts/backup-signing.mjs && git push"
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "diff": "5.2.2",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.18.2",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "monaco-editor": "0.52.2",
    "prismjs": "1.30.0",
    "qrcode-generator": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/diff": "5.2.3",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
